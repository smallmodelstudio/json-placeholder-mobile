{
  "name": "json-placeholder-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "doctor": "expo-doctor",
    "api:sync": "node scripts/api-sync.mjs",
    "api:generate": "openapi-typescript openapi/proxy.json -o src/api/schema.d.ts"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-worklets/jest/resolver.js",
    "moduleNameMapper": {
      "^msw/node$": "<rootDir>/node_modules/msw/lib/node/index.js"
    },
    "setupFiles": [
      "<rootDir>/src/test/setup-env.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setup-fetch-polyfill.ts",
      "<rootDir>/src/test/setup-msw.ts",
      "<rootDir>/src/test/setup-flash-list.ts"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|rettime|@open-draft/deferred-promise|until-async))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "transform": {
      "\\.mjs$": [
        "babel-jest",
        {
          "presets": [
            "expo/internal/babel-preset.js"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.103.1",
    "expo": "~57.0.23",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "expo-doctor": "^1.20.4",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.7",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "undici": "^8.10.2"
  }
}
